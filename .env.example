# Port for the local Express + WebSocket Activity server
PORT=3000

# Optional: Your Discord Application ID from https://discord.com/developers/applications
# (When launched inside Discord, the app also auto-detects this from <client_id>.discordsays.com!)
DISCORD_CLIENT_ID=

# Optional: Only needed if you add OAuth2 user authentication
DISCORD_CLIENT_SECRET=

# Default Twitch channel to load when a room starts (24/7 live stream recommended)
DEFAULT_TWITCH_CHANNEL=monstercat
